<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TubeNest 安裝精靈" Width="800" Height="780" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#F7F9FC"/><SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Ink" Color="#192533"/><SolidColorBrush x:Key="Muted" Color="#526174"/>
  <SolidColorBrush x:Key="Line" Color="#D5DDE8"/><SolidColorBrush x:Key="Accent" Color="#185ABD"/>
  <SolidColorBrush x:Key="Tint" Color="#EAF1FD"/><SolidColorBrush x:Key="Error" Color="#B3261E"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="18,8"/><Setter Property="Margin" Value="8,0,0,0"/>
   <Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="box" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Opacity" Value="0.83"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderThickness" Value="3"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="box" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="choice" BorderThickness="1" CornerRadius="10" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Card}" Padding="{TemplateBinding Padding}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="16" Height="16"><Ellipse Stroke="{DynamicResource Muted}" StrokeThickness="1"/><Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource Accent}" Visibility="Hidden"/></Grid>
      <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
     </Grid>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="choice" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="choice" Property="Background" Value="{DynamicResource Tint}"/><Setter TargetName="dot" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="choice" Property="BorderThickness" Value="3"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="choice" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{DynamicResource Surface}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="24,32">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top"><Image x:Name="Logo" Width="40" Height="40" HorizontalAlignment="Left"/><TextBlock Text="TubeNest" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="YouTube 下載助手" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="按下才啟動" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Text="完成後退出" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/><TextBlock x:Name="Version" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,20,0,0"/></StackPanel>
     <StackPanel Margin="0,44,0,0"><TextBlock x:Name="Step1" Text="01   選擇瀏覽器" FontWeight="SemiBold"/><TextBlock x:Name="Step2" Text="02   下載並安裝" Margin="0,28,0,0" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Step3" Text="03   瀏覽器確認" Margin="0,28,0,0" Foreground="{DynamicResource Muted}"/></StackPanel>
    </DockPanel>
   </Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,32,32,24">
     <TextBlock x:Name="Eyebrow" Text="WINDOWS 安裝精靈" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/>
     <TextBlock x:Name="Title" Text="準備好，就開始下載。" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,10"/>
     <TextBlock x:Name="Subtitle" Text="安裝所需工具，再將 TubeNest 加入你常用的瀏覽器。" Foreground="{DynamicResource Muted}" LineHeight="24" Margin="0,0,0,24"/>
     <StackPanel x:Name="Welcome">
      <TextBlock x:Name="DetectedInstall" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <RadioButton x:Name="InstallMode" GroupName="Mode" Content="標準安裝" Padding="10" Margin="0,0,6,0"/>
       <RadioButton x:Name="RepairMode" Grid.Column="1" GroupName="Mode" Content="檢查與修復" Padding="10" Margin="6,0,0,0"/>
      </Grid>
      <CheckBox x:Name="UpdateTools" Content="同時更新下載工具（適用於解析失敗／403）" Margin="0,0,0,20" Visibility="Collapsed" Foreground="{DynamicResource Ink}"/>
      <TextBlock Text="使用哪個瀏覽器？" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <RadioButton x:Name="Chrome" GroupName="Browser" AutomationProperties.Name="Google Chrome"><StackPanel><TextBlock Text="Google Chrome" FontWeight="SemiBold"/><TextBlock x:Name="ChromeHint" Text="已偵測到瀏覽器" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></RadioButton>
      <RadioButton x:Name="Edge" GroupName="Browser" AutomationProperties.Name="Microsoft Edge"><StackPanel><TextBlock Text="Microsoft Edge" FontWeight="SemiBold"/><TextBlock x:Name="EdgeHint" Text="已偵測到瀏覽器" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></RadioButton>
      <Border CornerRadius="10" Background="{DynamicResource Tint}" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="其餘交給安裝精靈" FontWeight="SemiBold"/><TextBlock Text="自動下載、驗證並安裝影片處理工具。僅安裝到目前帳號，不需要管理員權限。" Foreground="{DynamicResource Muted}" LineHeight="22" Margin="0,8,0,0"/></StackPanel></Border>
      <TextBlock Text="首次安裝需連線，工具約占數百 MB。最後需在瀏覽器載入擴充，精靈會提供路徑與操作指引。修復會檢查並重建助手連接；更新工具不保證能解決所有影片限制。" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="20" Margin="0,16,0,0"/>
     </StackPanel>
     <StackPanel x:Name="Installing" Visibility="Collapsed">
      <Border CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Card}" Padding="20">
       <StackPanel><DockPanel><TextBlock x:Name="Percent" DockPanel.Dock="Right" FontSize="22" FontWeight="SemiBold" Margin="16,0,0,0"/><TextBlock x:Name="Current" Text="準備安裝檔案" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <ProgressBar x:Name="Progress" Height="6" Margin="0,20,0,14" Minimum="0" Maximum="100" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" IsIndeterminate="True" AutomationProperties.Name="目前元件下載進度"/>
        <TextBlock x:Name="Transfer" Text="正在準備…" Foreground="{DynamicResource Muted}" FontSize="12"/>
       </StackPanel>
      </Border>
      <StackPanel Margin="4,24,0,16"><TextBlock x:Name="PrepareRow" Text="●  準備安裝檔案"/><TextBlock x:Name="DownloadRow" Text="○  下載與驗證官方元件" Margin="0,16,0,0"/><TextBlock x:Name="ConnectRow" Text="○  連接並檢查本機助手" Margin="0,16,0,0"/></StackPanel>
      <TextBlock Text="下載速度取決於網路；驗證與解壓縮時會顯示目前階段。你可以隨時取消，之後重新安裝。" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="20" Margin="0,8,0,0"/>
     </StackPanel>
     <StackPanel x:Name="Ready" Visibility="Collapsed">
      <Border Background="{DynamicResource Tint}" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="下載助手已就緒" FontWeight="SemiBold"/><TextBlock Text="官方工具與助手通訊檢查通過。接著在瀏覽器確認載入擴充。" Foreground="{DynamicResource Muted}" LineHeight="22" Margin="0,6,0,0"/></StackPanel></Border>
      <TextBlock Text="1   開啟「開發人員模式」" FontWeight="SemiBold" Margin="0,22,0,0"/>
      <TextBlock x:Name="LoadInstruction" Text="2   按「載入解壓縮」" FontWeight="SemiBold" Margin="0,14,0,0"/>
      <TextBlock Text="3   貼上資料夾路徑，再按「選擇資料夾」" FontWeight="SemiBold" Margin="0,14,0,12"/>
      <TextBox x:Name="Folder" IsReadOnly="True" Padding="10" Background="{DynamicResource Card}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" TextWrapping="Wrap" AutomationProperties.Name="擴充資料夾路徑"/>
      <DockPanel Margin="0,10,0,0"><Button x:Name="Copy" Content="複製路徑" DockPanel.Dock="Right"/><TextBlock x:Name="CopyHint" Text="開啟擴充頁時會自動複製。" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="已裝過 TubeNest？在擴充頁按「重新載入」，再重新整理 YouTube 即可。瀏覽器確認完成前，擴充尚未啟用。" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="20" Margin="0,16,0,0"/>
     </StackPanel>
     <Border x:Name="ErrorPanel" Visibility="Collapsed" BorderBrush="{DynamicResource Error}" BorderThickness="2,0,0,0" Padding="14,8" Margin="0,16,0,0"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" LineHeight="22"/></Border>
     <Expander x:Name="Details" Header="安裝詳細資訊" Margin="0,20,0,0" Visibility="Collapsed" Foreground="{DynamicResource Muted}">
      <StackPanel><TextBox x:Name="Log" Height="130" Margin="0,10,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="{DynamicResource Card}" Foreground="{DynamicResource Ink}" AutomationProperties.Name="安裝紀錄"/><TextBlock x:Name="LogPath" FontSize="11" Margin="0,6,0,0"/></StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,16">
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Secondary" Content="取消"/><Button x:Name="Primary" Content="開始安裝" Background="{DynamicResource Accent}" Foreground="White" BorderBrush="{DynamicResource Accent}" IsDefault="True"/></StackPanel><TextBlock x:Name="Footer" Text="Windows 10 / 11 · 64 位元" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
  </Border>
 </Grid>
</Window>
