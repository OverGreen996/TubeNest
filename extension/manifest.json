{
  "manifest_version": 3,
  "name": "TubeNest YouTube 下載",
  "version": "1.0.1",
  "description": "YouTube 與 Shorts 專用；按下啟動本機助手，完整驗證後保存，完成後退出。",
  "minimum_chrome_version": "127",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-button.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TubeNest YouTube 下載"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "setup.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "version_name": "1.0.1（按鈕修正測試版）",
  "host_permissions": [
    "https://www.youtube.com/*"
  ]
}